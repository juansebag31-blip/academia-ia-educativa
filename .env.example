# Public Supabase configuration. These values are safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical application URL. Vercel will provide the initial *.vercel.app URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Supabase Secret Key reserved for administrative server operations.
# Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only Gemini API key used for RAG embeddings and grounded answers.
# Never create NEXT_PUBLIC_GEMINI_API_KEY.
GEMINI_API_KEY=

# Server-only Gemini model used to generate grounded tutor answers.
# Recommended after the reproducible Phase 5A benchmark.
GEMINI_RAG_MODEL=gemini-3.5-flash-lite

# Experimental top-1 sufficiency gate. Calibrate again with real learner questions.
RAG_SIMILARITY_THRESHOLD=0.700

# Server-only HMAC secret for pseudonymous tutor rate-limit identities.
# Use at least 32 random characters. Never reuse API keys or expose it to the browser.
RAG_RATE_LIMIT_SECRET=

# Tutor request limits. Defaults shown: anonymous 5/day and 2/minute;
# authenticated 20/day and 5/minute.
RAG_ANONYMOUS_DAILY_LIMIT=5
RAG_AUTHENTICATED_DAILY_LIMIT=20
RAG_ANONYMOUS_MINUTE_LIMIT=2
RAG_AUTHENTICATED_MINUTE_LIMIT=5

# Global server-side safety budgets. Only real provider requests consume them.
# Cache hits consume neither budget; insufficient evidence consumes embedding only.
RAG_DAILY_GENERATION_BUDGET=400
RAG_DAILY_EMBEDDING_BUDGET=450

# Exact normalized response cache lifetime (30 days by default).
RAG_CACHE_TTL_SECONDS=2592000

# Local tutor API switch. It defaults to enabled in development and disabled in production.
# Leave empty to use the safe defaults: enabled in development and disabled in production.
# Set explicitly only when you intentionally override that behavior.
RAG_ASSISTANT_API_ENABLED=

# Server-only marketing configuration. Use long, independent random values.
MARKETING_HASH_SECRET=
MARKETING_DOWNLOAD_SECRET=

# Optional email delivery. Downloads still work when Resend is not configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Academia IA <recursos@example.com>

# Public contact shown in the privacy page.
NEXT_PUBLIC_CONTACT_EMAIL=
